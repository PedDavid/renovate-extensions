  <main class="mx-auto max-w-5xl px-4 py-6">
    
<div class="flex flex-col gap-6">
  <div class="flex flex-col gap-1">
    <h1 class="text-2xl font-semibold tracking-tight">Charts</h1>
    <p class="text-sm text-muted-foreground">What changed in a Helm chart bump: the chart's own changes and the releases of the app it packages. Any chart on Artifact Hub works; these are the ones looked up since chart-notes started.</p>
  </div>

  <form method="get" action="/" class="flex flex-wrap items-end gap-3" data-chart-lookup>
    <div class="field w-auto">
      <label for="lookup">Look up a chart</label>
      <input id="lookup" name="chart" class="input" placeholder="e.g. alloy" autocomplete="off" pattern="[A-Za-z0-9._-]+" required>
    </div>
    <button type="submit" class="btn" data-variant="outline">Versions <svg
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M5 12h14" />
  <path d="m12 5 7 7-7 7" />
</svg></button>
  </form>

  
  <div class="empty rounded-lg border border-dashed">
    <header>
      <figure><svg
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z" />
  <path d="M12 22V12" />
  <polyline points="3.29 7 12 12 20.71 7" />
  <path d="m7.5 4.27 9 5.15" />
</svg></figure>
      <h3>No charts looked up yet</h3>
      <p>Follow a link from a Renovate PR, or look one up above.</p>
    </header>
  </div>
  

  
  <p class="text-sm text-muted-foreground">Overridden in the Helm chart's values: <code class="text-xs">kube-prometheus-stack</code>, <code class="text-xs">offline</code>.</p>
  

  <div class="card">
    <header>
      <h2>Renovate config</h2>
      <p>Adds a <em>Notes</em> column to Helm chart PRs: a badge that starts looking everything up when the PR is opened, linking here. Charts from OCI registries aren't covered yet.</p>
    </header>
    <section>
      <pre class="overflow-x-auto rounded-md bg-muted p-4 text-xs"><code>&#34;packageRules&#34;: [
  {
    &#34;matchDatasources&#34;: [&#34;helm&#34;],
    // Renovate&#39;s default columns plus this one.
    &#34;prBodyColumns&#34;: [&#34;Package&#34;, &#34;Type&#34;, &#34;Update&#34;, &#34;Change&#34;, &#34;Pending&#34;, &#34;Notes&#34;],
    &#34;prBodyDefinitions&#34;: {
      &#34;Notes&#34;: &#34;[![release notes](https://chart-notes.example.com/{{{packageName}}}/badge.svg?from={{{currentVersion}}}&#38;to={{{newVersion}}}&#38;source={{{sourceUrl}}})](https://chart-notes.example.com/{{{packageName}}}?from={{{currentVersion}}}&#38;to={{{newVersion}}}&#38;source={{{sourceUrl}}})&#34;
    }
  }
]</code></pre>
    </section>
  </div>
</div>

  </main>
  <dialog id="command-palette" class="command-dialog" aria-label="Search charts">
    <div class="command">
      <header>
        <svg
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="m21 21-4.34-4.34" />
  <circle cx="11" cy="11" r="8" />
</svg>
        <input type="search" name="q" placeholder="Search charts…" autocomplete="off" aria-label="Search charts"
               role="combobox" aria-autocomplete="list" aria-controls="command-results" aria-expanded="false"
               hx-get="/search" hx-trigger="input changed delay:150ms, search, palette-open" hx-target="#command-results">
      </header>
      <div id="command-results" role="listbox" aria-label="Charts" data-empty="No charts found."></div>
    </div>
  </dialog>
