{
  "alloy": {
    "repo": "https://grafana.github.io/helm-charts",
    "app": "grafana/alloy"
  },
  "external-secrets": {
    "repo": "https://charts.external-secrets.io",
    "app": "external-secrets/external-secrets"
  },
  "kube-prometheus-stack": {
    "repo": "https://prometheus-community.github.io/helm-charts",
    "app": "prometheus-operator/prometheus-operator",
    "note": "This chart's appVersion is prometheus-operator's. Prometheus, Alertmanager and the other bundled images can change without it."
  },
  "loki": {
    "repo": "https://grafana-community.github.io/helm-charts",
    "app": "grafana/loki"
  },
  "metallb": {
    "repo": "https://metallb.github.io/metallb",
    "app": "metallb/metallb"
  },
  "openbao": {
    "repo": "https://openbao.github.io/openbao-helm",
    "app": "openbao/openbao"
  },
  "prometheus-json-exporter": {
    "repo": "https://prometheus-community.github.io/helm-charts",
    "app": "prometheus-community/json_exporter"
  },
  "pyroscope": {
    "repo": "https://grafana.github.io/helm-charts",
    "app": "grafana/pyroscope"
  },
  "reflector": {
    "repo": "https://emberstack.github.io/helm-charts",
    "app": "emberstack/kubernetes-reflector"
  },
  "reloader": {
    "repo": "https://stakater.github.io/stakater-charts",
    "app": "stakater/Reloader"
  },
  "tempo": {
    "repo": "https://grafana-community.github.io/helm-charts",
    "app": "grafana/tempo"
  },
  "traefik": {
    "repo": "https://traefik.github.io/charts",
    "app": "traefik/traefik"
  }
