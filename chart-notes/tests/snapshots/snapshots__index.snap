      </tbody>
    </table>
  </div>
  

  <div class="card">
    <header>
      <h2>Renovate config</h2>
      <p>Adds an <em>App notes</em> column to Helm chart PRs. Charts from OCI registries aren't covered.</p>
    </header>
    <section>
      <pre class="overflow-x-auto rounded-md bg-muted p-4 text-xs"><code>&#34;packageRules&#34;: [
  {
    &#34;matchDatasources&#34;: [&#34;helm&#34;],
    // Renovate&#39;s default columns plus this one.
    &#34;prBodyColumns&#34;: [&#34;Package&#34;, &#34;Type&#34;, &#34;Update&#34;, &#34;Change&#34;, &#34;Pending&#34;, &#34;App notes&#34;],
    &#34;prBodyDefinitions&#34;: {
      &#34;App notes&#34;: &#34;[app notes](https://chart-notes.example.com/{{{packageName}}}?from={{{currentVersion}}}&#38;to={{{newVersion}}})&#34;
    }
  }
]</code></pre>
    </section>
  </div>
</div>

  </main>
