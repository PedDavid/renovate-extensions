  <circle cx="11" cy="11" r="8" />
</svg>
        <input type="search" name="q" placeholder="Search charts…" autocomplete="off" aria-label="Search charts"
               role="combobox" aria-autocomplete="list" aria-controls="command-results" aria-expanded="false"
               hx-get="/search" hx-trigger="input changed delay:150ms, search, palette-open" hx-target="#command-results">
      </header>
      <div id="command-results" role="listbox" aria-label="Charts" data-empty="No charts found."></div>
    </div>
  </dialog>
